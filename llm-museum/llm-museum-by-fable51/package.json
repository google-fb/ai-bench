{
  "name": "llm-museum-by-fable51",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5174",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "deploy:cf": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name ${CLOUDFLARE_PAGES_PROJECT:-llm-museum}"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
